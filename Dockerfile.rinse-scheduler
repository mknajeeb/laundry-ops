# Azure Container Apps scheduled job: Rinse Playwright scrape + LaundryOps import.
#
# Build (repo root):
#   docker build -f Dockerfile.rinse-scheduler -t laundryops-rinse-scheduler .
#
# Run (example):
#   docker run --rm --env-file .env \
#     -v /path/to/rinse-data:/data/rinse-scrape \
#     -e RINSE_SCRAPE_DATA_ROOT=/data/rinse-scrape \
#     -e RINSE_SCHEDULED_SCRAPE_ENABLED=1 \
#     -e RINSE_SCHEDULED_ORG_IDS=3 \
#     -e RINSE_OFF_PORTAL_SCAN_REFRESH_ENABLED=1 \
#     -e RINSE_OFF_PORTAL_SCAN_REFRESH_DRY_RUN=0 \
#     -e RINSE_OFF_PORTAL_SCAN_REFRESH_MAX_BAGS=40 \
#     -e RINSE_OFF_PORTAL_SCAN_REFRESH_RUSH_ONLY=0 \
#     laundryops-rinse-scheduler

FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Node scraper (install Chromium into PLAYWRIGHT_BROWSERS_PATH for ACA job env)
COPY scripts/rinse-cleanertickets/package.json scripts/rinse-cleanertickets/package-lock.json \
  ./scripts/rinse-cleanertickets/
RUN mkdir -p /ms-playwright \
  && cd scripts/rinse-cleanertickets \
  && npm ci \
  && npx playwright install --with-deps chromium

COPY scripts/rinse-cleanertickets/*.mjs ./scripts/rinse-cleanertickets/

COPY scripts/rinse-tenants ./scripts/rinse-tenants

# Python app (import + confirm) — venv required on Debian bookworm (PEP 668)
COPY requirements.txt ./
RUN python3 -m venv /opt/laundry_venv \
  && /opt/laundry_venv/bin/pip install --no-cache-dir -r requirements.txt

COPY backend ./backend
COPY etl ./etl

ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/laundry_venv/bin:${PATH}"
ENV RINSE_SCRAPE_DATA_ROOT=/data/rinse-scrape

# Bake revision stamps into the image so runtime logs prove manager-lock code.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_SHA=${GIT_SHA}
ENV SOURCE_RELEASE_SHA=${GIT_SHA}
ENV ARTIFACT_SHA=${GIT_SHA}
ENV EXPECTED_RELEASE_SHA=${GIT_SHA}
ENV SCHEDULER_IMAGE_SHA=${GIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}
RUN printf '%s\n' "{\"sha\":\"${GIT_SHA}\",\"built_at\":\"${BUILD_TIME}\",\"component\":\"rinse-scheduler\"}" \
  > /app/backend/release_revision.json \
  && cp /app/backend/release_revision.json /app/release_revision.json

RUN mkdir -p /data/rinse-scrape

CMD ["/opt/laundry_venv/bin/python", "-m", "backend.jobs.run_rinse_freshness_supervisor"]
