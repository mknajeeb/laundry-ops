# WASHPRO — Rinse vendor portal (copy to .env.washpro, not committed)
# Login: your WASHPRO Rinse vendor email at https://www.rinse.com/vendors/

RINSE_TICKETS_URL=https://www.rinse.com/cleanertickets/?q=&status=at_vendor&page=1
RINSE_STORAGE_STATE=./rinse-auth-washpro.json

# After save-session, optional:
# RINSE_EMAIL=
# RINSE_PASSWORD=

RINSE_PAGE_START=1
RINSE_MAX_PAGES=500
RINSE_CSV_LAYOUT=portal

OUTPUT_CSV=./bag-ids-washpro.csv
OUTPUT_SCAN_TICKETS_CSV=./scan-events-washpro-tickets.csv
OUTPUT_SCAN_EVENTS_CSV=./scan-events-washpro-events.csv
