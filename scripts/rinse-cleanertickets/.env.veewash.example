# VEEWASH — Rinse vendor portal (copy to .env.veewash, not committed)
# Login: your VEEWASH Rinse vendor email at https://www.rinse.com/vendors/

RINSE_TICKETS_URL=https://www.rinse.com/cleanertickets/?q=&status=at_vendor&page=1
RINSE_STORAGE_STATE=./rinse-auth-veewash.json

# After save-session, optional:
# RINSE_EMAIL=
# RINSE_PASSWORD=

RINSE_PAGE_START=1
RINSE_MAX_PAGES=500
RINSE_CSV_LAYOUT=portal

OUTPUT_CSV=./bag-ids-veewash.csv
OUTPUT_SCAN_TICKETS_CSV=./scan-events-veewash-tickets.csv
OUTPUT_SCAN_EVENTS_CSV=./scan-events-veewash-events.csv
