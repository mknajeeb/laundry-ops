# Multiple Rinse vendors (WASHPRO vs VEEWASH): use separate auth files — see README_MULTI_TENANT.md
#   cp .env.washpro.example .env.washpro && ./use-rinse-tenant.sh washpro npm run save-session
#
# Ticket LIST url to scrape (copy from browser AFTER you log in at https://www.rinse.com/vendors/ ).
# Login is email/password (or rinse-auth.json) — not this URL alone. page= is updated while scraping.
RINSE_TICKETS_URL=https://www.rinse.com/cleanertickets/?q=&status=at_vendor&page=1

# Optional unattended login (MFA often blocks this — prefer npm run save-session + RINSE_STORAGE_STATE)
# RINSE_EMAIL=
# RINSE_PASSWORD=

# Pagination: first page number and hard cap (default 500). Stops earlier on empty table or when a
# page repeats any earlier page (same table text or same bag IDs — Rinse often wraps after the last page).
RINSE_PAGE_START=1
RINSE_MAX_PAGES=500

# Output CSV (default: bag-ids-YYYY-MM-DD.csv in this folder). Use an absolute path for cron.
# OUTPUT_CSV=/Users/you/exports/rinse-bags.csv

# Scan-events extension (scrape-scan-events.mjs — not production scrape.mjs)
# OUTPUT_SCAN_TICKETS_CSV=/Users/you/exports/scan-events-YYYY-MM-DD-tickets.csv
# OUTPUT_SCAN_EVENTS_CSV=/Users/you/exports/scan-events-YYYY-MM-DD-events.csv
# RINSE_SCAN_TABLE_SETTLE_MS=600
# RINSE_SCAN_INCLUDE_EMPTY_TICKETS=1

# CSV shape: legacy = page,row_index,customer_snippet,bag_id,raw_line
# portal = Excel-style columns (Date, Customer, Weight, Notes, USE OXIC, …, Bag ID) for ops sheets
# RINSE_CSV_LAYOUT=portal

# After running: npm run save-session  — put path here so nightly run does not need password
# Mac users: auth is per vendor (tenants/washpro/rinse-auth.json, tenants/veewash/…).
# Use save-session.command — do not rely on a single root rinse-auth.json.
# RINSE_STORAGE_STATE=./rinse-auth.json

# Only if NOT using storage state (fragile if Rinse adds MFA)
# RINSE_EMAIL=
# RINSE_PASSWORD=

HEADED=0

# Portal CSV Notes column: none (default) = leave empty (special instructions live in USE OXIC / Use Hypo / … flags).
# Set to full if you want the old long free-text notes (e.g. “Use Hypoallergenic Soap”) in Notes.
# RINSE_PORTAL_NOTES=full

# Speed tuning (ms). Lower = faster; raise if rows miss bag/weight on slow machines.
# RINSE_TABLE_WAIT_MS=450
# RINSE_TABLE_AFTER_MS=180
# RINSE_ROW_GAP_MS=10
# RINSE_TABLE_WHEEL_STEPS=7
# RINSE_EXPAND_SETTLE_MS=450
# RINSE_VENDORINLINE_SETTLE_MS=120
# RINSE_BAG_DETAILS_SETTLE_MS=350
# RINSE_SHOW_BAG_WAIT_MS=4000
# RINSE_PAGE_SETTLE_MS=1100
# Poll DOM for bag text before clicking Show bag details (reduces long waits).
# RINSE_BAG_DOM_WAIT_MS=900
# RINSE_BAG_DOM_POLL_MS=60

# If the browser hangs after ticket 1: collapse waits are bounded; hide “bag details” + Escape first.
# RINSE_ROW_ACTION_TIMEOUT_MS=3200
# RINSE_COLLAPSE_MAX_MS=12000
# Row collapse between tickets is OFF by default (it often stalls). Set to 0 only if you need it.
# RINSE_SKIP_ROW_COLLAPSE=0
# RINSE_COLLAPSE_MAX_ITERS=12
