# Base cleaner-tickets URL (page= is overwritten while scraping)
RINSE_TICKETS_URL=https://www.rinse.com/cleanertickets/?q=&status=at_vendor&page=1

# Pagination: first page number and max pages to try (stops early if a page has zero rows)
RINSE_PAGE_START=1
RINSE_MAX_PAGES=50

# Output CSV (default: bag-ids-YYYY-MM-DD.csv in this folder). Use an absolute path for cron.
# OUTPUT_CSV=/Users/you/exports/rinse-bags.csv

# CSV shape: legacy = page,row_index,customer_snippet,bag_id,raw_line
# portal = Excel-style columns (Date, Customer, Weight, Notes, USE OXIC, …, Bag ID) for ops sheets
# RINSE_CSV_LAYOUT=portal

# After running: npm run save-session  — put path here so nightly run does not need password
# RINSE_STORAGE_STATE=./rinse-auth.json

# Only if NOT using storage state (fragile if Rinse adds MFA)
# RINSE_EMAIL=
# RINSE_PASSWORD=

HEADED=0

# Portal CSV Notes column: none (default) = leave empty (special instructions live in USE OXIC / Use Hypo / … flags).
# Set to full if you want the old long free-text notes (e.g. “Use Hypoallergenic Soap”) in Notes.
# RINSE_PORTAL_NOTES=full

# Speed tuning (ms). Lower = faster; raise if rows miss bag/weight on slow machines.
# RINSE_TABLE_WAIT_MS=900
# RINSE_TABLE_AFTER_MS=350
# RINSE_ROW_GAP_MS=25
# RINSE_EXPAND_SETTLE_MS=450
# RINSE_VENDORINLINE_SETTLE_MS=200
# RINSE_BAG_DETAILS_SETTLE_MS=350
# RINSE_SHOW_BAG_WAIT_MS=4000
# RINSE_PAGE_SETTLE_MS=2200

# If the browser hangs after ticket 1: collapse waits are bounded; hide “bag details” + Escape first.
# RINSE_ROW_ACTION_TIMEOUT_MS=3200
# RINSE_COLLAPSE_MAX_MS=12000
# Row collapse between tickets is OFF by default (it often stalls). Set to 0 only if you need it.
# RINSE_SKIP_ROW_COLLAPSE=0
# RINSE_COLLAPSE_MAX_ITERS=12
