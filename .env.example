# Backend (Flask) — copy to `.env` in the project root (do not commit `.env`)
MYSQL_HOST=mkncentralussrv1.mysql.database.azure.com
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=laundryapp
MYSQL_PORT=3306
# Connection pool size (default 32, max 32 per mysql-connector). Each parallel HTTP request
# holds one pooled connection until the response finishes — raise if you see "pool exhausted".
# MYSQL_POOL_SIZE=32
# Optional TLS: set MYSQL_SSL_CA to a PEM path, or MYSQL_SSL_REQUIRED=true to force TLS without a custom CA.
# MYSQL_SSL_CA=/path/to/DigiCertGlobalRootG2.crt.pem
# MYSQL_SSL_REQUIRED=true

# Used to sign Time & Attendance API tokens (set a long random string in production)
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Flask listen port (must match Vite dev proxy below when using npm run dev).
# PORT=8000

# Frontend (Vite) — optional; defaults to deployed API in src/api.js
# Vite loads env from this same file (repo root): see frontend/vite.config.js envDir.
# Only variables prefixed with VITE_ are exposed to the browser.
# Dev proxy target for /auth, /api, … defaults to http://127.0.0.1:${PORT} (see vite.config.js).
# If you change PORT (e.g. 8001), set the same in .env or set explicitly:
# VITE_DEV_API_PROXY=http://127.0.0.1:8001
# VITE_API_BASE=http://127.0.0.1:8000

# Public base URL of this Flask API (for organization logo URLs when using local file storage).
# Use the host/port browsers hit for the API, e.g. when Vite proxies or you open the API directly:
# PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Azure Blob Storage (order ticket images, organization logo uploads) ---
# 1) Azure Portal → your Storage account → Security + networking → Access keys
#    Copy the full "Connection string" (not only the account key).
# 2) Local: paste into `.env` in this repo root and restart the Flask process.
# 3) Production: Azure Web App (laundryops-api) → Settings → Environment variables
#    → Application settings → + Add → name AZURE_STORAGE_CONNECTION_STRING → save → Restart app.
# 4) Container: defaults to order-tickets. Override if needed:
# ORDER_TICKET_CONTAINER=order-tickets
# The API creates this container on first use when the connection string has permission.
# 5) Public read for <img> logos/tickets: Portal → Containers → select the container →
#    "Change access level" → Blob (anonymous read access for blobs only).
#    Without that, uploads may succeed but browsers cannot load the raw blob URL unless you front with CDN/SAS.
# 6) Alternative: leave storage unset and set only an HTTPS "Logo URL" on Organization settings (no file upload).

# --- Notifications (PWA-friendly: no SMS) ---
# Channels: web + mobile push (same PWA / FCM), email, WhatsApp. Preferences: GET/PUT /auth/me/notification-preferences
# (email_*, push_*, whatsapp_*). Inbound stubs: POST /api/notify/webhook/whatsapp (and legacy /api/notify/webhook/sms).
#
# Push (desktop + mobile browser install):
# - Use the Web Push API in the PWA + a service worker; backend sends via Firebase Cloud Messaging (HTTP v1) or
#   web-push (VAPID). One subscription covers installed PWA on phone and desktop Chrome/Edge.
#
# Email:
# - Resend, Brevo, SendGrid, or SMTP. Free tiers are fine for dev/low volume.
#
# WhatsApp (no SMS):
# - Meta WhatsApp Business Platform (Cloud API), or Twilio WhatsApp. Requires approved business number + templates
#   for outbound; inbound webhooks map to POST /api/notify/webhook/whatsapp (verify signatures in production).
#
# Optional all-in-one: OneSignal supports push + email; add WhatsApp via their channel or call Meta/Twilio separately.
#
# OneSignal Web Push: add here (or GitHub Actions variable for production builds)
# VITE_ONESIGNAL_APP_ID=<OneSignal → Keys & IDs → App ID> (same value as below for server sends)
# ONESIGNAL_APP_ID=<same App ID UUID>  # optional duplicate; else Flask uses VITE_ONESIGNAL_APP_ID
# ONESIGNAL_REST_API_KEY=<OneSignal → Keys & IDs → REST API Key>  # server-only; targeted + broadcast push
# Optional: ONESIGNAL_BROADCAST_SEGMENT=Subscribed Users
# frontend/public/OneSignalSDKWorker.js is in the repo (same as OneSignal SDK zip).
# External User ID format: lo-{organization_id}-{user_id} (browser OneSignal.login + backend send_push_*).
#
# Notification hub (groups, event routing, audit log): run backend/sql/notification_module_v1.sql on MySQL.
# Enable the "notifications" tenant module in Platform → tenant entitlements so the nav item appears.
#
# Production: Azure App Settings / Key Vault — not committed here.
# RESEND_API_KEY=          # or SENDGRID_API_KEY, etc.
# EMAIL_FROM=noreply@yourdomain.com
# FCM_PROJECT_ID=          # Firebase; use service account JSON path for server send
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json
# WHATSAPP_ACCESS_TOKEN=   # Meta Cloud API permanent token (example)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=   # for webhook verification callback
#
# Password reset: send email via provider above; tokens in password_reset_tokens (created on first use).
#
# --- Scheduled batch jobs (document compliance: reminders, mark expired, optional payroll deactivation) ---
# Local:  python -m backend.jobs.run_change_jobs
#         python -m backend.jobs.run_change_jobs --dry-run
# Production without a server cron: POST to your API base, e.g. curl -X POST \
#   "https://your-api-host/internal/jobs/change-jobs" \
#   -H "X-Change-Jobs-Secret: <same value as below>"
# Optional dry run: append ?dry_run=1
# CHANGE_JOBS_SECRET=use-a-long-random-string
# Deep links in reminder pushes (browser origin of the Washpro / PWA app, not the Flask port):
# WEB_APP_BASE=https://your-frontend-host.example
#
# --- HR / payroll form assets (official PDFs EN+ES, internal DOCX) ---
# Canonical list: backend/hr_forms/catalog.json
# Copy your Downloads files into backend/hr_form_assets/forms/ using the filenames
# in catalog "files" (e.g. ny_ls54_en.pdf, uscis_i9_es.pdf, irs_w4_en.pdf).
# Optional: point to another folder (absolute path recommended on servers):
# HR_FORM_ASSETS_DIR=/path/to/forms
# I-9 English still falls back to backend/hr_form_assets/i-9.pdf or HR_I9_TEMPLATE_PATH
# until uscis_i9_en.pdf exists in HR_FORM_ASSETS_DIR.
# Year-specific IRS templates in catalog.json use "tax_year"; set to match the files you installed:
# HR_FORMS_TAX_YEAR=2026
# Optional: cap AcroForm fill pages (large combined PDFs): HR_PDF_MAX_PAGES=4
# AcroForm text appearance (W-4, W-9, etc.): HR_PDF_FIELD_FONT=times|helvetica|courier (default times),
#   HR_PDF_FIELD_FONT_PT=9, HR_PDF_FIELD_FONT_BOLD=0
# Flattening bakes field values into the page (can look softer); default off: HR_PDF_FLATTEN=0.
# If fields look blank in a viewer, try HR_PDF_FLATTEN=true
#
# Employer structured address + EIN on organizations (run once on MySQL):
#   backend/sql/organizations_employer_form_fields_v1.sql
#
# Google Places (optional): address autocomplete on Organization → employer street
# VITE_GOOGLE_MAPS_API_KEY=your_browser_restricted_key
